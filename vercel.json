
{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "services": {
      "movie-booking": {
        "root": "Frontend/movie-booking",
        "framework": "vite"
      },
      "backend": {
        "root": "Backend",
        "framework": "django"
      }
    },
    "rewrites": [
      {
        "source": "/api/(.*)",
        "destination": {
          "service": "backend"
        }
      },
      {
        "source": "/(.*)",
        "destination": {
          "service": "movie-booking"
        }
      }
    ]
  }
  